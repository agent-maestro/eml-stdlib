// window_hamming.eml -- Hamming window function.
//
//   w[n] = a0 - a1 * cos(2*pi*n / (N-1))    for n in [0, N-1]
//   a0 = 0.54, a1 = 0.46
//
// Like Hann but with a small DC offset that cancels the first
// side-lobe of the spectrum, reducing leakage from -32dB (Hann) to
// -43dB at the cost of a non-zero w[0] = 0.08.

module window_hamming;

const TWO_PI: Real = 6.283185307179586
const A0:     Real = 0.54
const A1:     Real = 0.46

@verify(lean, theorem = "hamming_in_unit_interval")
fn hamming(n: Real, length_minus_1: Real) -> Real
    where chain_order <= 1,
          domain: length_minus_1 > 0.0
    requires (n >= 0.0)
    requires (n <= length_minus_1)
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    A0 - A1 * cos(TWO_PI * n / length_minus_1)
}

// Boundary: w[0] = a0 - a1 = 0.08.
@verify(lean, theorem = "hamming_at_zero_is_offset")
fn hamming_at_start(length_minus_1: Real) -> Real
    where chain_order <= 0,
          domain: length_minus_1 > 0.0
    ensures (result == 0.08)
{
    A0 - A1
}

@verify(lean, theorem = "hamming_windowed_in_input_band")
fn hamming_apply(x: Real, n: Real, length_minus_1: Real) -> Real
    where chain_order <= 1,
          domain: length_minus_1 > 0.0
    requires (n >= 0.0)
    requires (n <= length_minus_1)
{
    let w = A0 - A1 * cos(TWO_PI * n / length_minus_1);
    w * x
}
