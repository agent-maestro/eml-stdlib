// highpass.eml -- 1st-order RC high-pass filter step.
//
//   y[n] = alpha * (y[n-1] + x[n] - x[n-1])
//   alpha = RC / (RC + dt)
//
// Pass alpha close to 1 for low cutoff (slow drift removal). Like
// the matching low-pass kernel, this is stateless: caller threads
// (prev_x, prev_y) through frames.

module highpass;

@verify(lean, theorem = "hpf1_zero_for_dc")
fn hpf1_step(x: Real, prev_x: Real, prev_y: Real, alpha: Real) -> Real
    where chain_order <= 0
    requires (alpha >= 0.0)
    requires (alpha <= 1.0)
{
    alpha * (prev_y + x - prev_x)
}

// Convert (RC, dt) -> alpha for a high-pass.
@verify(lean, theorem = "hpf_alpha_in_unit_interval")
fn alpha_from_rc_dt(rc: Real, dt: Real) -> Real
    where chain_order <= 0,
          domain: rc > 0.0 && dt >= 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    rc / (rc + dt)
}

const TWO_PI: Real = 6.283185307179586

// Convert (cutoff_hz, dt) -> alpha.
@verify(lean, theorem = "hpf_alpha_from_cutoff_in_unit_interval")
fn alpha_from_cutoff(cutoff_hz: Real, dt: Real) -> Real
    where chain_order <= 0,
          domain: cutoff_hz > 0.0 && dt >= 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    let omega = TWO_PI * cutoff_hz;
    let rc    = 1.0 / omega;
    rc / (rc + dt)
}
