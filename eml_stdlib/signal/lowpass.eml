// lowpass.eml -- 1st-order RC low-pass filter step.
//
//   y[n] = alpha * x[n] + (1 - alpha) * y[n-1]
//   alpha = dt / (RC + dt)
//
// Stateless: caller passes prev_y and stores the new y. Chain
// order 0 -- pure linear combination, no transcendentals.
//
// For 2nd-order or steeper roll-offs, see biquad_lowpass in the
// audio industry library; this kernel is the Hz-band canonical
// "single-pole" you want for 95% of applications.

module lowpass;

@verify(lean, theorem = "lpf1_in_input_band")
fn lpf1_step(x: Real, prev_y: Real, alpha: Real) -> Real
    where chain_order <= 0
    requires (alpha >= 0.0)
    requires (alpha <= 1.0)
{
    alpha * x + (1.0 - alpha) * prev_y
}

// Convert (RC, dt) -> alpha. Closed form so the controller
// can adapt the cutoff without leaving EML.
@verify(lean, theorem = "alpha_from_rc_dt_in_unit_interval")
fn alpha_from_rc_dt(rc: Real, dt: Real) -> Real
    where chain_order <= 0,
          domain: rc > 0.0 && dt >= 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    dt / (rc + dt)
}

// Convert (cutoff_hz, dt) -> alpha. RC = 1 / (2*pi*fc).
const TWO_PI: Real = 6.283185307179586

@verify(lean, theorem = "alpha_from_cutoff_in_unit_interval")
fn alpha_from_cutoff(cutoff_hz: Real, dt: Real) -> Real
    where chain_order <= 0,
          domain: cutoff_hz > 0.0 && dt >= 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    let omega = TWO_PI * cutoff_hz;
    let rc    = 1.0 / omega;
    dt / (rc + dt)
}
