// caustics.eml -- refracted-light interference pattern.
//
// Cheap caustics for pool / sea-floor effects: two perpendicular
// sine waves perturbed by Perlin noise, multiplied. Result ∈ [0, 1].

module caustics;

use stdlib::gaming::noise::perlin_2d;

const PI: Real = 3.141592653589793

@verify(lean, theorem = "caustics_in_unit_interval")
fn intensity(x: Real, y: Real, time_s: Real, scale: Real) -> Real
    where chain_order <= 1,
          domain: scale > 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    let n: Real = perlin_2d::perlin2(x * 0.5, y * 0.5);
    let s_a: Real = sin(2.0 * PI * scale * (x + 0.3 * n) + time_s * 1.3);
    let s_b: Real = sin(2.0 * PI * scale * (y - 0.3 * n) + time_s * 1.7);
    let raw: Real = s_a * s_b;
    let highlit: Real = raw * raw;
    clamp(highlit, 0.0, 1.0)
}
