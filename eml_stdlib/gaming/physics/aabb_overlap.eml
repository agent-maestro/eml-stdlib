// aabb_overlap.eml -- axis-aligned bounding box intersection test.
//
// Returns 1.0 if the two AABBs overlap, 0.0 otherwise. Inputs:
// (min, max) for each box on each axis.

module aabb_overlap;

@verify(lean, theorem = "aabb2_overlap_in_zero_one")
fn overlap_2d(a_min_x: Real, a_max_x: Real, a_min_y: Real, a_max_y: Real,
              b_min_x: Real, b_max_x: Real, b_min_y: Real, b_max_y: Real) -> Real
    where chain_order <= 0
    requires (a_min_x <= a_max_x)
    requires (a_min_y <= a_max_y)
    requires (b_min_x <= b_max_x)
    requires (b_min_y <= b_max_y)
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    if a_max_x < b_min_x { 0.0 }
    else if a_min_x > b_max_x { 0.0 }
    else if a_max_y < b_min_y { 0.0 }
    else if a_min_y > b_max_y { 0.0 }
    else { 1.0 }
}

// Penetration depth on a single axis (signed; sign indicates side).
@verify(lean, theorem = "aabb_penetration_depth_signed")
fn penetration_depth_x(a_min_x: Real, a_max_x: Real,
                        b_min_x: Real, b_max_x: Real) -> Real
    where chain_order <= 0
    requires (a_min_x <= a_max_x)
    requires (b_min_x <= b_max_x)
{
    let right_overlap: Real = a_max_x - b_min_x;
    let left_overlap: Real  = b_max_x - a_min_x;
    if abs(right_overlap) < abs(left_overlap) { right_overlap }
    else { -left_overlap }
}
