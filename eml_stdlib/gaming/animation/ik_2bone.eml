// ik_2bone.eml -- two-bone inverse kinematics via law of cosines.
//
// Given an upper bone of length L1 and a lower bone of length L2,
// reach a target at distance D from the shoulder. Compute the
// shoulder + elbow joint angles:
//
//   cos(elbow) = (L1² + L2² - D²) / (2 * L1 * L2)
//   cos(α)    = (L1² + D² - L2²) / (2 * L1 * D)   // shoulder, target-relative
//
// Returns the elbow angle (rad) and the shoulder offset angle (rad)
// as separate functions so the caller can compose with the
// shoulder-to-target azimuth.

module ik_2bone;

@verify(lean, theorem = "elbow_angle_in_pi_band")
fn elbow_angle(l1: Real, l2: Real, distance: Real) -> Real
    where chain_order <= 1,
          domain: l1 > 0.0 && l2 > 0.0 && distance > 0.0
    ensures (result >= 0.0)
    ensures (result <= 3.141592653589793)
{
    let cos_e: Real = clamp(
        (l1 * l1 + l2 * l2 - distance * distance) / (2.0 * l1 * l2),
        -1.0, 1.0
    );
    acos(cos_e)
}

@verify(lean, theorem = "shoulder_angle_in_half_pi_band")
fn shoulder_offset(l1: Real, l2: Real, distance: Real) -> Real
    where chain_order <= 1,
          domain: l1 > 0.0 && l2 > 0.0 && distance > 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.5707963267948966)
{
    let cos_a: Real = clamp(
        (l1 * l1 + distance * distance - l2 * l2) / (2.0 * l1 * distance),
        -1.0, 1.0
    );
    acos(cos_a)
}

// Reachability: returns 1.0 if the target is reachable, 0.0 if not.
@verify(lean, theorem = "ik_reachable_in_zero_one")
fn reachable(l1: Real, l2: Real, distance: Real) -> Real
    where chain_order <= 0,
          domain: l1 > 0.0 && l2 > 0.0 && distance >= 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    let max_reach: Real = l1 + l2;
    let min_reach: Real = abs(l1 - l2);
    if distance > max_reach { 0.0 }
    else if distance < min_reach { 0.0 }
    else { 1.0 }
}
