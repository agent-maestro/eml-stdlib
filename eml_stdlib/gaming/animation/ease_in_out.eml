// ease_in_out.eml -- smoothstep: 3t² - 2t³.

module ease_in_out;

@verify(lean, theorem = "smoothstep_in_unit_interval")
fn smoothstep(t: Real) -> Real
    where chain_order <= 0
    requires (t >= 0.0)
    requires (t <= 1.0)
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    3.0 * t * t - 2.0 * t * t * t
}

// Quintic smootherstep — 6t⁵ - 15t⁴ + 10t³, C² continuous.
@verify(lean, theorem = "smootherstep_in_unit_interval")
fn smootherstep(t: Real) -> Real
    where chain_order <= 0
    requires (t >= 0.0)
    requires (t <= 1.0)
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    let t3: Real = t * t * t;
    let t4: Real = t3 * t;
    let t5: Real = t4 * t;
    6.0 * t5 - 15.0 * t4 + 10.0 * t3
}
