// fov_projection.eml -- perspective projection matrix coefficients.
//
// Returns the four non-zero entries of a standard right-handed
// perspective matrix (column-major):
//
//   m00 = 1 / (aspect * tan(fov/2))
//   m11 = 1 / tan(fov/2)
//   m22 = -(far + near) / (far - near)
//   m23 = -(2 * far * near) / (far - near)

module fov_projection;

// The fov upper bound is the symbolic pi() (half-FOV in the first quadrant
// (0, pi/2) ⇒ tan > 0 ⇒ the coefficient is positive). pi() renders as the EXACT
// real pi in the Lean obligation, so `fov < pi` ⇒ `0.5*fov < pi/2` cleanly;
// compute backends lower it to the float64 literal, so the runtime domain is
// the standard "FOV below 180°". (Was the decimal 3.141, which needed the
// unprovable `3.141 < pi` bridge.)
@verify(lean, theorem = "fov_m00_positive")
fn m00(fov_y_rad: Real, aspect: Real) -> Real
    where chain_order <= 2,
          domain: fov_y_rad > 0.0 && fov_y_rad < pi() && aspect > 0.0
    ensures (result > 0.0)
{
    1.0 / (aspect * tan(0.5 * fov_y_rad))
}

@verify(lean, theorem = "fov_m11_positive")
fn m11(fov_y_rad: Real) -> Real
    where chain_order <= 2,
          domain: fov_y_rad > 0.0 && fov_y_rad < pi()
    ensures (result > 0.0)
{
    1.0 / tan(0.5 * fov_y_rad)
}

@verify(lean, theorem = "fov_m22_signed")
fn m22(near: Real, far: Real) -> Real
    where chain_order <= 0,
          domain: near > 0.0 && far > near
    ensures (result < 0.0)
{
    -(far + near) / (far - near)
}

@verify(lean, theorem = "fov_m23_signed")
fn m23(near: Real, far: Real) -> Real
    where chain_order <= 0,
          domain: near > 0.0 && far > near
    ensures (result < 0.0)
{
    -(2.0 * far * near) / (far - near)
}
