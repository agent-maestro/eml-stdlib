// fog_exp2.eml -- squared-exponential fog.
//
//   transmittance(d) = exp(-(density * d)²)
//
// Sharper transition than fog_exp; favoured by older fixed-function
// pipelines. Output ∈ [0, 1].

module fog_exp2;

@verify(lean, theorem = "fog_exp2_in_unit_interval")
fn fog_factor(density: Real, distance_m: Real) -> Real
    where chain_order <= 1,
          domain: density >= 0.0 && distance_m >= 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    let d: Real = density * distance_m;
    1.0 - exp(-(d * d))
}

@verify(lean, theorem = "fog_exp2_transmittance_in_unit_interval")
fn transmittance(density: Real, distance_m: Real) -> Real
    where chain_order <= 1,
          domain: density >= 0.0 && distance_m >= 0.0
    ensures (result >= 0.0)
    ensures (result <= 1.0)
{
    let d: Real = density * distance_m;
    exp(-(d * d))
}
