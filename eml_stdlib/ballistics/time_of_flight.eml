// time_of_flight.eml -- iterative time-of-flight under quadratic drag.
//
// In vacuum, t = R / v_0. Drag complicates this: the bullet
// decelerates, so the average velocity is less than v_0 and the
// true time-of-flight is longer.
//
// Two solutions ship here:
//
//   tof_vacuum            : R / v_0       (chain 0, baseline only)
//   tof_constant_decel    : closed-form quadratic, treats drag
//                            deceleration as constant (chain 0)
//   tof_pejsa             : Pejsa retardation-coefficient form
//                            (chain 1, log) — most accurate single-
//                            step approximation ballistic calculators
//                            use in the field.
//
// For the iterative-solver path, host code calls tof_step with the
// current (range_remaining, v) state until convergence.

module time_of_flight;

@verify(lean, theorem = "tof_vacuum_nonneg")
fn tof_vacuum(range_m: Real, v_0: Real) -> Real
    where chain_order <= 0,
          domain: v_0 > 0.0 && range_m >= 0.0
    ensures (result >= 0.0)
{
    range_m / v_0
}

// Constant-deceleration model: v(t) = v_0 - a*t, range = ∫v dt.
//   R = v_0 * t - ½ * a * t²
//   t = (v_0 - sqrt(v_0² - 2*a*R)) / a
@verify(lean, theorem = "tof_constant_decel_nonneg")
fn tof_constant_decel(range_m: Real, v_0: Real, drag_decel: Real) -> Real
    where chain_order <= 1,
          domain: v_0 > 0.0 && range_m >= 0.0 && drag_decel >= 0.0
    ensures (result >= 0.0)
{
    let disc: Real = v_0 * v_0 - 2.0 * drag_decel * range_m;
    let safe_disc: Real = clamp(disc, 0.0, v_0 * v_0);
    (v_0 - sqrt(safe_disc)) / clamp(drag_decel, 1.0e-6, 1.0e6)
}

// Pejsa form: t = R / V_avg, V_avg = (V_0 + V_R) / 2 with
// V_R = V_0 * exp(-R / k), where k is the retardation coefficient
// derived from the ballistic coefficient.
@verify(lean, theorem = "tof_pejsa_nonneg")
fn tof_pejsa(range_m: Real, v_0: Real, k_retard: Real) -> Real
    where chain_order <= 1,
          domain: v_0 > 0.0 && k_retard > 0.0 && range_m >= 0.0
    ensures (result >= 0.0)
{
    let v_remaining: Real = v_0 * exp(-range_m / k_retard);
    let v_avg: Real = 0.5 * (v_0 + v_remaining);
    range_m / v_avg
}

// Single integration step for an iterative solver. dt is the time
// step; returns the new (range_remaining, v) tuple-ish via two
// helper functions.
@verify(lean, theorem = "tof_step_range_decreases")
fn step_range(range_remaining: Real, v: Real, dt: Real) -> Real
    where chain_order <= 0,
          domain: dt >= 0.0 && range_remaining >= 0.0 && v >= 0.0
    ensures (result <= range_remaining)
{
    clamp(range_remaining - v * dt, 0.0, range_remaining)
}

@verify(lean, theorem = "tof_step_velocity_nonneg")
fn step_velocity(v: Real, drag_decel: Real, dt: Real) -> Real
    where chain_order <= 0,
          domain: drag_decel >= 0.0 && dt >= 0.0
    requires (v >= 0.0)
    ensures (result >= 0.0)
{
    clamp(v - drag_decel * dt, 0.0, v)
}
