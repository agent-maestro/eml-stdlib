// bangbang.eml -- bang-bang (relay) controller.
//
// The simplest possible feedback controller:
//   u = u_max if error > 0 else u_min
//
// Used in thermostats, on/off relays, and as a sanity-check
// reference for more sophisticated controllers. Chain order 0;
// branchless under the optimiser via clamp(sign(...)*range, ...).

module bangbang;

@verify(lean, theorem = "bangbang_in_actuator_band")
fn bangbang(error: Real, u_max: Real, u_min: Real) -> Real
    where chain_order <= 0
    requires (u_max >= u_min)
    ensures (result >= u_min)
    ensures (result <= u_max)
{
    let s = clamp(error * 1.0e30, -1.0, 1.0);
    let mid = 0.5 * (u_max + u_min);
    let amp = 0.5 * (u_max - u_min);
    mid + s * amp
}

// Symmetric bang-bang -- output is +/- u_amp.
@verify(lean, theorem = "bangbang_sym_in_band")
fn bangbang_symmetric(error: Real, u_amp: Real) -> Real
    where chain_order <= 0
    requires (u_amp >= 0.0)
    ensures (abs(result) <= u_amp)
{
    let s = clamp(error * 1.0e30, -1.0, 1.0);
    s * u_amp
}
