// atan.eml -- arctangent.
//
// Chain order 1. Output is bounded to (-pi/2, pi/2) so any caller
// can reason about bounded output without a separate clamp.

module atan_module;

// NOTE (real-vs-float subtlety): the true range of atan is the OPEN interval
// (-pi/2, pi/2); atan(x) -> +-pi/2 only as x -> +-inf, never reaching it. The
// constant below is the nearest IEEE-754 double to pi/2, which is STRICTLY LESS
// than pi/2 (1.5707963267948966 < 1.57079632679489661923...). So the strict
// bound `result > -HALF_PI` is true in float arithmetic but FALSE over the reals
// for sufficiently large negative x (atan(x) can fall in the gap
// (-pi/2, -HALF_PI)). The `atan_in_open_half_pi_band` obligation is therefore
// left UNVERIFIED on purpose: a sound Lean proof needs a symbolic `pi/2` bound
// (not a truncated decimal) plus an arctan range axiom in MachLib. Flagged
// rather than closed with an unsound axiom.
const HALF_PI: Real = 1.5707963267948966

@verify(lean, theorem = "atan_in_open_half_pi_band")
fn atan_kernel(x: Real) -> Real
    where chain_order <= 1
    ensures (result >  -HALF_PI)
    ensures (result <   HALF_PI)
{
    atan(x)
}

@verify(lean, theorem = "atan_zero_is_zero")
fn atan_at_zero() -> Real
    where chain_order <= 0
    ensures (result == 0.0)
{
    atan(0.0)
}

@verify(lean, theorem = "atan_odd_at_one")
fn atan_at_one() -> Real
    where chain_order <= 0
{
    atan(1.0)
}
