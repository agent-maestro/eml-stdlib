// atan.eml -- arctangent.
//
// Chain order 1. Output is bounded to (-pi/2, pi/2) so any caller
// can reason about bounded output without a separate clamp.

module atan_module;

// NOTE (why the bound is symbolic pi(), not a decimal): the true range of atan
// is the OPEN interval (-pi/2, pi/2); atan(x) -> +-pi/2 only as x -> +-inf,
// never reaching it. The nearest IEEE-754 double to pi/2 is STRICTLY LESS than
// pi/2 (1.5707963267948966 < 1.57079632679489661923...), so a decimal `HALF_PI`
// bound is FALSE over the reals for large negative x (atan can land in the gap
// (-pi/2, -HALF_PI)) and the obligation cannot be closed soundly. The `pi()`
// builtin renders the EXACT real pi/2 in the Lean/Coq/Isabelle obligation
// (Real.pi, PI, pi) while compute backends still lower it to the float64-nearest
// literal, so this is sound AND keeps runtime semantics. Closed against the
// MachLib arctan range lemmas (no unsound axiom).

@verify(lean, theorem = "atan_in_open_half_pi_band")
fn atan_kernel(x: Real) -> Real
    where chain_order <= 1
    ensures (result >  -(pi() / 2.0))
    ensures (result <    pi() / 2.0)
{
    atan(x)
}

@verify(lean, theorem = "atan_zero_is_zero")
fn atan_at_zero() -> Real
    where chain_order <= 0
    ensures (result == 0.0)
{
    atan(0.0)
}

@verify(lean, theorem = "atan_odd_at_one")
fn atan_at_one() -> Real
    where chain_order <= 0
{
    atan(1.0)
}
