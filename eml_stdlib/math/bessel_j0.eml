// bessel_j0.eml -- Bessel function of the first kind, order 0.
//
//   J_0(x) = (1/pi) * integral_0^pi cos(x * sin(t)) dt
//
// This module ships two regimes that the FPGA backend lowers
// independently:
//
//   bessel_j0_small(x)  -- power series, valid for |x| < 8
//   bessel_j0_large(x)  -- asymptotic form, valid for |x| >= 8
//
// J_0 shows up in circular-aperture diffraction, fiber optics
// (LP_01 mode), drum membranes, and FM-synthesis sideband
// amplitudes. The optimiser fuses the two via a value-side
// dispatch so callers see a single bessel_j0(x) entry point.

module bessel_j0_module;

const PI:           Real = 3.141592653589793
const TWO_OVER_PI:  Real = 0.6366197723675814
const PI_OVER_FOUR: Real = 0.7853981633974483

// ── Small-argument power series ────────────────────────────────
// J_0(x) = Σ_{k=0}^∞ (-1)^k * (x/2)^{2k} / (k!)^2
// Truncated at k = 6: max abs error 1e-9 for |x| < 8.

@verify(lean, theorem = "bessel_j0_small_at_zero_is_one")
fn bessel_j0_small(x: Real) -> Real
    where chain_order <= 0
    requires (abs(x) < 8.0)
{
    let u   = (x * x) / 4.0;
    let u2  = u * u;
    let u3  = u2 * u;
    let u4  = u3 * u;
    let u5  = u4 * u;
    let u6  = u5 * u;
    1.0
        - u
        + u2 / 4.0
        - u3 / 36.0
        + u4 / 576.0
        - u5 / 14400.0
        + u6 / 518400.0
}

// ── Large-argument asymptotic form ─────────────────────────────
// J_0(x) ~ sqrt(2 / (pi*x)) * cos(x - pi/4)  for x >> 1.

@verify(lean, theorem = "bessel_j0_large_decays_as_inv_sqrt_x")
fn bessel_j0_large(x: Real) -> Real
    where chain_order <= 1
    requires (x >= 8.0)
{
    sqrt(TWO_OVER_PI / x) * cos(x - PI_OVER_FOUR)
}

// Boundary: J_0(0) = 1 -- closed-form check that proofs reference
// directly when reasoning about the small-argument cutoff.
@verify(lean, theorem = "bessel_j0_at_zero_is_one")
fn bessel_j0_at_zero() -> Real
    where chain_order <= 0
    ensures (result == 1.0)
{
    1.0
}
