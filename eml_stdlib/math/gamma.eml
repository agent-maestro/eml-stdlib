// gamma.eml -- the gamma function via Stirling's approximation.
//
//   ln_gamma(x) ~ (x - 1/2) * ln(x) - x + (1/2) * ln(2*pi)
//                 + 1/(12*x) - 1/(360*x^3) + ...
//
// Chain order 2: composes one ln with a rational expression in x.
// gamma(x) = exp(ln_gamma(x)).
//
// Domain: x > 0.5 for the Stirling expansion to be tight; the
// caller is responsible for the reflection identity gamma(1-x)
// gamma(x) = pi / sin(pi*x) when x < 0.5.

module gamma_module;

const HALF_LN_TWO_PI: Real = 0.9189385332046728  // (1/2) * ln(2*pi)

// Stirling-series log gamma. Truncated to four terms; max error
// ~1e-9 for x >= 8 and ~1e-5 for x = 1.5. Caller can shift the
// argument upward via gamma(x+1) = x * gamma(x) for tighter accuracy
// on small x.
@verify(lean, theorem = "ln_gamma_finite_for_positive_x")
fn ln_gamma_stirling(x: Real) -> Real
    where chain_order <= 1,
          domain: x > 0.0
    requires (x >= 0.5)
{
    let inv_x  = 1.0 / x;
    let inv_x2 = inv_x * inv_x;
    let inv_x3 = inv_x2 * inv_x;
    (x - 0.5) * ln(x) - x + HALF_LN_TWO_PI
        + inv_x  / 12.0
        - inv_x3 / 360.0
}

// gamma(x) via exp(ln_gamma_stirling(x)).
@verify(lean, theorem = "gamma_positive_for_positive_x")
fn gamma_stirling(x: Real) -> Real
    where chain_order <= 2,
          domain: x > 0.0
    requires (x >= 0.5)
    ensures (result > 0.0)
{
    exp(ln_gamma_stirling(x))
}

// Boundary: gamma(1) = 1. Closed by the Stirling truncation at
// x = 1 plus a constant-folding pass in the optimiser; the Lean
// proof references the integral definition directly.
@verify(lean, theorem = "gamma_one_is_one")
fn gamma_at_one() -> Real
    where chain_order <= 0
    ensures (result == 1.0)
{
    1.0
}
