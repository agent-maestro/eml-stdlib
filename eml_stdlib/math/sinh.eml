// sinh.eml -- hyperbolic sine.
//
// sinh(x) = (e^x - e^-x) / 2. Chain order 1 -- the two exps fold
// through one shared evaluator on most backends.

module sinh_module;

const SINH_X_MAX: Real = 30.0

@verify(lean, theorem = "sinh_zero_is_zero")
fn sinh_kernel(x: Real) -> Real
    where chain_order <= 1
    requires (abs(x) < SINH_X_MAX)
{
    sinh(x)
}

@verify(lean, theorem = "sinh_zero_is_zero_at_zero")
fn sinh_at_zero() -> Real
    where chain_order <= 0
    ensures (result == 0.0)
{
    sinh(0.0)
}
