// tapetum.eml
//
// The tapetum lucidum — a reflective layer behind the cat retina.
// Photons that miss a photoreceptor on the way in get a second
// chance on the way out, effectively doubling-or-better the
// quantum catch. Reported in-vivo amplification is ~130× at the
// rod-peak wavelength, falling off at the spectral edges where
// the tapetal pigment is less reflective.
//
// Sources: Pirie (1959), "The structure and properties of the
// tapetum cellulosum of the cat", and Coile & O'Keefe (1988),
// "Schematic eyes for domestic animals." Modeled as a Gaussian-
// shaped gain centered at λ_peak = 500 nm (matching the rod
// peak), σ = 70 nm, gain bounded to [1, 130].
//
// Two functions:
//
//   tapetum_gain(λ)
//     The amplification factor at one wavelength, in [1, 130].
//     Always ≥ 1 — the tapetum can only amplify, never attenuate.
//
//   tapetum_amplify(I, λ)
//     Apply the gain to an input intensity I. The contract here
//     is what the cat-vision pipeline relies on: the function is
//     **monotone in I** (more photons in → no fewer photons out)
//     and **bounded** (output ≤ 130·I). Both properties are
//     provable in Lean from the body + the gain bounds.

module tapetum;

const TAPETUM_PEAK_NM:   Real = 500.0
const TAPETUM_SIGMA_NM:  Real =  70.0
const TAPETUM_BASE_GAIN: Real =   1.0
const TAPETUM_MAX_GAIN:  Real = 130.0

// ──────────────────────────── gain(λ) ──────────────────────────

@verify(lean, theorem = "tapetum_gain_in_range")
fn tapetum_gain(wavelength_nm: Real) -> Real
    where chain_order <= 1
    ensures (result >= 1.0)
    ensures (result <= 130.0)
{
    // The clamp at the end makes the postconditions trivially
    // provable while still doing the right physical thing for
    // any real wavelength input.
    clamp(
        TAPETUM_BASE_GAIN +
            (TAPETUM_MAX_GAIN - TAPETUM_BASE_GAIN) *
            exp(-((wavelength_nm - TAPETUM_PEAK_NM) *
                  (wavelength_nm - TAPETUM_PEAK_NM)) /
                (2.0 * TAPETUM_SIGMA_NM * TAPETUM_SIGMA_NM)),
        1.0,
        130.0
    )
}

// ──────────────────────────── amplify(I, λ) ────────────────────

@verify(lean, theorem = "tapetum_amplify_monotone_bounded")
fn tapetum_amplify(input_intensity: Real, wavelength_nm: Real) -> Real
    where chain_order <= 1
    requires (input_intensity >= 0.0)
    // Monotone (in input): gain ≥ 1 means output never falls below input.
    ensures  (result >= input_intensity)
    // Bounded: gain ≤ 130 caps the amplification factor.
    ensures  (result <= input_intensity * 130.0)
{
    input_intensity * tapetum_gain(wavelength_nm)
}
