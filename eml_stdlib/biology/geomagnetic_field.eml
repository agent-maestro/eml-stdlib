// geomagnetic_field.eml
//
// Earth's magnetic field magnitude as a function of geomagnetic
// latitude. Modeled as a centered axial dipole — the leading-order
// approximation that captures ~95 % of the surface field:
//
//     B(λ) = B_eq · √(1 + 3 · sin²(λ))
//
// B_eq ≈ 30 µT at the equator; the field is twice as strong
// (~60 µT) at the poles where field lines converge. Pigeons
// navigate using the *magnitude* component of this map for the
// "map" sense and the inclination angle (separate file) for
// "compass" — the famous Wiltschko (1972) bicomponent model.
//
// Postcondition: B > 0 everywhere on Earth's surface (the dipole
// has no zeros). The Cryptochrome model downstream takes B as
// an input and would divide-by-zero on a vanishing field.

module geomagnetic_field;

const B_EQUATORIAL_T: Real = 3.0e-5   // 30 µT — IGRF equatorial baseline

@verify(lean, theorem = "geomagnetic_field_strictly_positive")
fn geomagnetic_field(latitude_rad: Real)
    -> Real{r | r >= B_EQUATORIAL_T}
    where chain_order <= 1
{
    // sqrt(1 + 3·sin²) ≥ 1 ⇒ result ≥ B_eq. We use max() as the
    // outer guard so the postcondition is one-line provable.
    max(B_EQUATORIAL_T,
        B_EQUATORIAL_T * sqrt(1.0 + 3.0 * sin(latitude_rad) * sin(latitude_rad)))
}
